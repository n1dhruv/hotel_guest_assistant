# =======================================================
# LiteLLM Universal Model Selection
# =======================================================
# You can use ANY model by changing LLM_MODEL and adding the corresponding key below:
# Examples:
# - LLM_MODEL=gpt-4o-mini (OpenAI)
# - LLM_MODEL=gemini/gemini-2.0-flash (Google Gemini)
# - LLM_MODEL=claude-3-5-sonnet-20241022 (Anthropic)
# - LLM_MODEL=groq/llama-3.3-70b-versatile (Groq)
# - LLM_MODEL=ollama/llama3 (Local Ollama, no key needed)
LLM_MODEL=gpt-4o-mini

# Provider API Keys (Leave empty to automatically run in offline dynamic RAG mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Force deterministic mock mode even if keys are present (optional)
MOCK_LLM=false

# Qdrant Vector DB Configuration (Dual-Mode: Local Embedded $0 or Free Cloud)
# Leave QDRANT_URL empty to use local embedded storage (app/data/qdrant_storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=hotel_knowledge_base
# Set to true to run Qdrant purely in Python RAM (no disk files, perfect for serverless/ephemeral live hosting)
QDRANT_IN_MEMORY=false

# Embedding Model: FastEmbed BAAI/bge-small-en-v1.5 (384 dim, local CPU, $0, no quota).
# Set EMBEDDING_PROVIDER=openrouter to opt back into Nemotron-3-Embed-1B (2048 dim, quota-metered).
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=openrouter/nvidia/nemotron-3-embed-1b:free

# HyDE (Hypothetical Document Embeddings) Query Pipeline
HYDE_ENABLED=true
HYDE_MODEL=
HYDE_MAX_TOKENS=80
HYDE_TIMEOUT=2.5

# Hybrid Search Pipeline (Qdrant Vector + BM25 with Reciprocal Rank Fusion)
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60
HYBRID_TOP_K=10
HYBRID_DENSE_CANDIDATES=10
HYBRID_BM25_CANDIDATES=10

# Reranker Pipeline: FlashRank MiniLM (local ONNX cross-encoder, $0, no quota).
# Set RERANKER_PROVIDER=openrouter for Nemotron Rerank (quota-metered) or "local" for the deterministic scorer.
RERANKER_ENABLED=true
RERANKER_PROVIDER=flashrank
RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free
# TinyBERT (~4MB) fits Render free-tier 512MB; use ms-marco-MiniLM-L-12-v2 (~80MB) only with headroom.
RERANKER_LOCAL_MODEL=ms-marco-TinyBERT-L-2-v2
RERANKER_TOP_N=3
RERANKER_TIMEOUT=6.0

# Hotel knowledge base location
HOTEL_DATA_PATH=app/data/hotel_data.json

# Server configuration
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or JSON list; defaults to localhost + *.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
