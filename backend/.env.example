# =======================================================
# LiteLLM Universal Model Selection
# =======================================================
# You can use ANY model by changing LLM_MODEL and adding the corresponding key below:
# Examples:
# - LLM_MODEL=gpt-4o-mini (OpenAI)
# - LLM_MODEL=gemini/gemini-2.0-flash (Google Gemini)
# - LLM_MODEL=claude-3-5-sonnet-20241022 (Anthropic)
# - LLM_MODEL=groq/llama-3.3-70b-versatile (Groq)
# - LLM_MODEL=ollama/llama3 (Local Ollama, no key needed)
LLM_MODEL=gpt-4o-mini

# Provider API Keys (Leave empty to automatically run in offline dynamic RAG mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Force deterministic mock mode even if keys are present (optional)
MOCK_LLM=false

# Hotel knowledge base location
HOTEL_DATA_PATH=app/data/hotel_data.json

# Server configuration
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or JSON list; defaults to localhost + *.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
