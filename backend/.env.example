# =======================================================
# LiteLLM Universal Model Selection
# =======================================================
# You can use ANY model by changing LLM_MODEL and adding the corresponding key below:
# Examples:
# - LLM_MODEL=gpt-4o-mini (OpenAI)
# - LLM_MODEL=gemini/gemini-2.0-flash (Google Gemini)
# - LLM_MODEL=claude-3-5-sonnet-20241022 (Anthropic)
# - LLM_MODEL=groq/llama-3.3-70b-versatile (Groq)
# - LLM_MODEL=ollama/llama3 (Local Ollama, no key needed)
LLM_MODEL=gpt-4o-mini

# Provider API Keys (Leave empty to automatically run in offline dynamic RAG mock mode)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Force deterministic mock mode even if keys are present (optional)
MOCK_LLM=false

# Qdrant Vector DB Configuration (Dual-Mode: Local Embedded $0 or Free Cloud)
# Leave QDRANT_URL empty to use local embedded storage (app/data/qdrant_storage)
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=hotel_knowledge_base
# Set to true to run Qdrant purely in Python RAM (no disk files, perfect for serverless/ephemeral live hosting)
QDRANT_IN_MEMORY=false

# Embedding Model: gemini-embedding-2 via LiteLLM (3072 dimensions)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini/gemini-embedding-2

# HyDE (Hypothetical Document Embeddings) Query Pipeline
HYDE_ENABLED=true
HYDE_MODEL=
HYDE_MAX_TOKENS=80
HYDE_TIMEOUT=2.5

# Hotel knowledge base location
HOTEL_DATA_PATH=app/data/hotel_data.json

# Server configuration
DEBUG=false
PORT=8000
HOST=0.0.0.0

# Allowed CORS Origins (comma-separated or JSON list; defaults to localhost + *.vercel.app)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
