# OpenAI API Key (Leave empty to automatically run in offline MOCK_LLM mode)
OPENAI_API_KEY=

# Mock LLM mode (Set to true to force deterministic mock responses without an API key)
MOCK_LLM=false

# Hotel knowledge base location
HOTEL_DATA_PATH=app/data/hotel_data.json

# Server configuration
DEBUG=true
PORT=8000
HOST=0.0.0.0
